# MySQL Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=stockmarket_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=stockmarket_db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Application Configuration
APP_NAME=AI Market Analysis Assistant
APP_VERSION=1.0.0
DEBUG=True

# Data Storage
DATA_DIR=/app/data
CHROMA_DB_PATH=/app/data/chroma_db

# Indian Stock Market API
STOCK_API_BASE_URL=https://indian-stock-exchange-api.p.rapidapi.com
# Note: Using 0xramm API which doesn't require API key initially

# Scraper Configuration
SCRAPER_DELAY_SECONDS=2
MAX_ARTICLES_PER_SOURCE=50

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# Sentiment Configuration  
SENTIMENT_MODEL=gpt-4o-mini
