# Environment variables for Docker Compose and Production
# Copy this file to .env and fill in your actual values

# =============================================================================
# AUTHENTICATION  & SECURITY
# =============================================================================

# JWT Configuration (REQUIRED)
# Generate secret key with: openssl rand -hex 32
# IMPORTANT: Use different keys for development and production!
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS CONFIGURATION (Production)
# =============================================================================

# Allowed Origins (comma-separated, no spaces)
# Example: https://myapp.streamlit.app,https://api.example.com
# Leave empty for development (will use defaults)
ALLOWED_ORIGINS=

# =============================================================================
# CAPTCHA (Optional but recommended for production)
# =============================================================================

# Provider: "hcaptcha" or "recaptcha"
CAPTCHA_PROVIDER=hcaptcha
# Get keys from: https://www.hcaptcha.com/ or https://www.google.com/recaptcha
CAPTCHA_SECRET_KEY=your_captcha_secret_key_here
CAPTCHA_SITE_KEY=your_captcha_site_key_here

# =============================================================================
# REDIS (Rate Limiting & Caching)
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# DATABASE
# =============================================================================

MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=stockmarket_db
MYSQL_USER=stockmarket_user
MYSQL_PASSWORD=secure_password_123
MYSQL_HOST=mysql
MYSQL_PORT=3306

# =============================================================================
# OPENAI API (Azure)
# =============================================================================

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2023-07-01-preview

# =============================================================================
# STOCK APIS
# =============================================================================

FINNHUB_API_KEY=your_finnhub_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
MARKETSTACK_API_KEY=your_marketstack_key

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

APP_NAME=AI Stock Market Analysis
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
LOG_FORMAT=structured

