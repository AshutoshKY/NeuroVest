# NeuroVest Production Environment Template
# Copy this to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
MYSQL_ROOT_PASSWORD=change_this_to_secure_password
MYSQL_PASSWORD=change_this_to_secure_password

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_very_long_random_string

# ===========================================
# AZURE OPENAI (Required for AI features)
# ===========================================
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ===========================================
# STOCK DATA APIs
# ===========================================
FINNHUB_API_KEY=your_finnhub_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
MARKETSTACK_API_KEY=your_marketstack_key

# ===========================================
# CORS (Frontend Domains)
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://neurovest.vercel.app,https://your-custom-domain.com
